# LF source files; Windows scripts use CRLF. Binary assets never receive text conversion.
# Git LFS is disabled (ADR-0017); source-art manifests and budgeted derivatives stay in the repo.
* text=auto eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
pnpm-lock.yaml text eol=lf -diff linguist-generated
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.exr   binary
*.hdr   binary
*.tif   binary
*.tiff  binary
*.psd   binary
*.ktx2  binary
*.glb   binary
*.bin   binary
*.gltf  text eol=lf -diff
*.ogg   binary
*.opus  binary
*.webm  binary
*.mp3   binary
*.wav   binary
*.woff2 binary
*.ttf   binary
*.blend binary
*.wasm  binary
*.zip   binary
*.pdf   binary
