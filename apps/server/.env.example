# =============================================================================================
# apps/server/.env.example
#
# Copy to apps/server/.env for local development (that file is git-ignored; start the server with
# `node --env-file=.env` or the dev script once it exists).
# Real staging/production values are set ONLY in the Render dashboard:
#   Render -> the service (moon-cleanup-server / moon-cleanup-server-staging) -> Environment
# Never commit real values. Every value below is a placeholder.
# =============================================================================================

# Runtime mode: development | test | production. Render services run with production.
NODE_ENV=development

# HTTP/WebSocket listen port. Render provides PORT itself (default 10000); locally use
# 2567 + agent offset N (docs/architecture/module-boundaries.md section 6).
PORT=2567

# PostgreSQL connection string (Service URI) of this environment's database.
# Where: Aiven console -> your PostgreSQL service -> Overview -> Connection information -> Service URI.
# Use database name moon_prod (production), moon_staging (staging), or a local database for dev.
# Render: paste it into the service's Environment tab (it is a secret).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/moon_staging?sslmode=require

# Aiven project CA certificate, FULL PEM text (including the BEGIN/END CERTIFICATE lines).
# Where: Aiven console -> your PostgreSQL service -> Overview -> Connection information ->
# CA certificate -> Download or copy, then paste the PEM as the value (Render accepts multi-line
# values). Locally, leave empty if your local Postgres does not use TLS.
DATABASE_CA_CERT=

# Postgres schema for this environment: prod | staging (Drizzle pgSchema / search_path; set per
# service in render.yaml). Lets production and staging share one Aiven database if the free plan
# allows no second one (OPEN_QUESTIONS Q19). Locally leave prod, or use a scratch schema name.
DB_SCHEMA=prod

# Secret used to sign 15-minute access-token JWTs (jose, HS256+). At least 32 random characters.
# Where: Render generates it for you on the first Blueprint apply (render.yaml generateValue);
# locally generate your own with a password manager (random, 48+ characters).
JWT_SECRET=replace-me-with-a-long-random-string-from-a-password-manager

# Secret pepper for refresh-token, recovery-code, join-ticket and IP hashes. At least 32 random
# characters. Where: Render generates it on the first Blueprint apply (render.yaml generateValue);
# locally generate your own. Changing it invalidates all stored refresh tokens and recovery codes.
REFRESH_TOKEN_PEPPER=replace-me-with-another-long-random-string

# Comma-separated list of exact browser origins allowed by CORS and the WebSocket handshake
# (no trailing slash). Production: https://moon-cleanup.vercel.app
# Staging: the Vercel stable branch URL for `main` (Vercel -> project -> Domains).
ALLOWED_ORIGINS=http://localhost:5173

# Sentry DSN of the SERVER (Node) project: Sentry -> Settings -> Projects -> <server project> ->
# Client Keys (DSN). Leave empty to disable error reporting locally.
SENTRY_DSN=

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Simulation step rate in Hz (Render Free budget: 20).
SIM_TICK_HZ=20

# Frame/patch rate in Hz (bandwidth budget: 10). Must divide SIM_TICK_HZ (30/15 on a paid instance).
SNAPSHOT_HZ=10

# HARD CEILING on live rooms per instance (default 3). Admission is decided by the measured tick
# budget below it (TICK_BUDGET_MS), see docs/architecture/netcode.md section 15.
MAX_ROOMS=3

# Admission budget in ms: sum of room tick p95 + new-room estimate must stay below this (default 3.5).
TICK_BUDGET_MS=3.5

# The single Render-documented client-IP header used for per-IP rate limits (default true-client-ip;
# confirm in M0). Empty locally = use the socket address. Never trust a whole X-Forwarded-For chain;
# the value x-forwarded-for means the right-most entry only (docs/architecture/security.md section 5).
CLIENT_IP_HEADER=

# Build identifier for /healthz, logs, Sentry and lease ids. NOT set on Render (not in render.yaml):
# the server derives it from RENDER_GIT_COMMIT there. Locally leave "dev".
BUILD_VERSION=dev

# Environment label used in logs/Sentry: local | staging | production (set in render.yaml).
ENV_NAME=local

# Persistence backend: postgres | memory (memory = local only; refused when ENV_NAME is not local).
PERSISTENCE_DRIVER=memory

# Max DB connections from this instance (default 4; production 4, staging 2, local 2).
DB_POOL_MAX=2

# OPTIONAL, temporary: previous JWT signing key still accepted for verification during rotation.
# Where: copy the old JWT_SECRET into Render -> Environment while rotating, then remove. Empty locally.
JWT_SECRET_PREVIOUS=

# REST trace sampling rate (default 0.01). Never per tick.
SENTRY_TRACES_SAMPLE_RATE=0.01

# Max connected clients per instance (default 24).
MAX_CLIENTS=24

# Max seconds between checkpoints of a dirty room (default 30, max 30).
CHECKPOINT_INTERVAL_S=30

# Reconnection seat-hold window in seconds (default 60).
SEAT_HOLD_S=60

# Node heap cap for the 512 MB Render Free instance (set in render.yaml).
NODE_OPTIONS=--max-old-space-size=384