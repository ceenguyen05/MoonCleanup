# =============================================================================================
# apps/server/.env.example
#
# Copy to apps/server/.env for local development (that file is git-ignored; start the server with
# `node --env-file=.env` or the dev script once it exists).
# Real hosted values are set ONLY in the Render dashboard:
#   Render -> moon-cleanup-server (branch main) -> Environment
# Full connection instructions: docs/HOSTING_GUIDE.md.
# Never commit real values. Every value below is a placeholder.
# =============================================================================================

# Runtime mode: development | test | production. Render services run with production.
NODE_ENV=development

# HTTP/WebSocket listen port. Render provides PORT itself (default 10000); locally use
# 2567 + agent offset N (docs/architecture/module-boundaries.md section 6).
PORT=2567

# PostgreSQL connection string of this environment's database (Neon Free, plain Postgres).
# Where: Neon console -> your project -> Connect -> Connection pooling OFF (DIRECT string, host WITHOUT -pooler)
# -> Show password -> copy. Region aws-us-east-2. Keep sslmode=require (the server refuses non-TLS URLs unless ENV_NAME=local).
# Schema prod inside the default neondb database. Render: paste it into the service's Environment tab (secret).
# Leave empty for local memory mode. URI shape only (replace privately when using Postgres):
# postgresql://USER:URL_ENCODED_PASSWORD@ep-NAME-ID.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OPTIONAL custom CA certificate, full PEM text. Leave EMPTY for Neon: its certificate is publicly trusted and is
# verified against Node's system CA store (verification is never disabled). Only set it for a private-CA database.
DATABASE_CA_CERT=

# Postgres schema (Drizzle pgSchema / search_path). Hosted service uses prod.
# Local Postgres tests use an isolated database/schema, never live hosted saves.
DB_SCHEMA=prod

# Secret used to sign 15-minute access-token JWTs (jose, HS256+). At least 32 random characters.
# Where: Render generates it for you on the first Blueprint apply (render.yaml generateValue);
# locally generate your own with a password manager (random, 48+ characters).
JWT_SECRET=replace-me-with-a-long-random-string-from-a-password-manager

# Secret pepper for refresh-token, recovery-code, join-ticket and IP hashes. At least 32 random
# characters. Where: Render generates it on the first Blueprint apply (render.yaml generateValue);
# locally generate your own. Changing it invalidates all stored refresh tokens and recovery codes.
REFRESH_TOKEN_PEPPER=replace-me-with-another-long-random-string

# Comma-separated list of exact browser origins allowed by CORS and the WebSocket handshake
# (no trailing slash). Production: https://cleanthemoon.vercel.app (use your real Vercel origin; Vercel preview URLs are not allowed unless added here)
# Production Branch is main. Add preview origins only when intentionally testing with safe data.
ALLOWED_ORIGINS=http://localhost:5173

# Sentry DSN of the SERVER (Node) project: Sentry -> Settings -> Projects -> <server project> ->
# Client Keys (DSN). Leave empty to disable error reporting locally.
SENTRY_DSN=

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Simulation step rate in Hz (Render Free budget: 20).
SIM_TICK_HZ=20

# Frame/patch rate in Hz (bandwidth budget: 10). Must divide SIM_TICK_HZ (30/15 on a paid instance).
SNAPSHOT_HZ=10

# HARD CEILING on live rooms per instance (default 3). Admission is decided by the measured tick
# budget below it (TICK_BUDGET_MS), see docs/architecture/netcode.md section 15.
MAX_ROOMS=3

# Live seats (joined + reserved) allowed per client IP (default 6 = one full room; owner decision 2026-11-14).
MAX_SEATS_PER_IP=6

# Admission budget in ms: sum of room tick p95 + new-room estimate must stay below this (default 3.5).
TICK_BUDGET_MS=3.5

# The single Render-documented client-IP header used for per-IP rate limits. Production (render.yaml) sets
# true-client-ip. Blank = trust no header and use the TCP socket address; that is only allowed when
# ENV_NAME=local (startup refuses it otherwise). Keep it blank for local runs, bots and browser dev: with a
# header set locally every request lands in the tighter shared "unknown" bucket (10 joins/min, 2 room creates/min).
# Never trust a whole X-Forwarded-For chain; the value x-forwarded-for means the right-most entry only
# (docs/architecture/security.md section 5).
CLIENT_IP_HEADER=

# Build identifier for /healthz, logs, Sentry and lease ids. NOT set on Render (not in render.yaml):
# the server derives it from RENDER_GIT_COMMIT there. Locally leave "dev".
BUILD_VERSION=dev

# Environment label used in logs/Sentry: local | production (set in render.yaml).
ENV_NAME=local

# Persistence backend: postgres | memory (memory = local only; refused when ENV_NAME is not local).
PERSISTENCE_DRIVER=memory

# Max DB connections from this instance (hosted 4, local 2).
DB_POOL_MAX=2

# OPTIONAL, temporary: previous JWT signing key still accepted for verification during rotation.
# Where: copy the old JWT_SECRET into Render -> Environment while rotating, then remove. Empty locally.
JWT_SECRET_PREVIOUS=

# REST trace sampling rate (default 0.01). Never per tick.
SENTRY_TRACES_SAMPLE_RATE=0.01

# Max connected clients per instance (default 12; room cap is 6 players).
MAX_CLIENTS=12

# Max seconds between checkpoints of a dirty room (default 30, max 30).
CHECKPOINT_INTERVAL_S=30

# Process-wide decompression budget for solo checkpoint uploads/downloads (512 MB / 0.1 CPU Render Free defaults).
# Inflated MiB per minute (1-1024, default 32 = one maximum upload per minute), verifications at once (1-4, default 1),
# and verifications allowed to wait before further ones get 503 RETRY_LATER (0-16, default 3).
CHECKPOINT_INFLATE_MIB_PER_MIN=32
CHECKPOINT_INFLATE_CONCURRENCY=1
CHECKPOINT_INFLATE_QUEUE=3

# Reconnection seat-hold window in seconds (default 60).
SEAT_HOLD_S=60

# Temporary network spike rooms. Off normally; never enable with live players/data.
NET_SPIKE=0

# WebSocket transport: auto (default: uWebSockets.js, falls back to Colyseus' ws transport with one
# "[net] transport=ws (uWebSockets.js unavailable: ...)" warning if it cannot load), uws (fail if unavailable), ws.
TRANSPORT=auto

# Node heap cap for the 512 MB Render Free instance (set in render.yaml).
NODE_OPTIONS=--max-old-space-size=384
