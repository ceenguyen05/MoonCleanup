{
  "name": "@moon-cleanup/server",
  "version": "0.0.0",
  "private": true,
  "description": "Clean The Moon! game server: Colyseus 0.18 rooms on uWebSockets.js (ws fallback) + REST API (deployed to Render Free).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/app/index.ts",
    "build": "node build.config.mjs",
    "start": "node dist/index.js",
    "seed": "echo NOT IMPLEMENTED: server seed (arrives with M1 persistence task)",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@colyseus/core": "0.18.28",
    "@colyseus/schema": "5.0.48",
    "@colyseus/uwebsockets-transport": "0.18.5",
    "@colyseus/ws-transport": "0.18.5",
    "@moon-cleanup/db": "workspace:*",
    "@moon-cleanup/game-data": "workspace:*",
    "@moon-cleanup/protocol": "workspace:*",
    "@moon-cleanup/shared": "workspace:*",
    "@moon-cleanup/sim": "workspace:*",
    "@moon-cleanup/world": "workspace:*",
    "@sentry/node": "11.12.0",
    "jose": "6.2.17",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.4.1",
    "uwebsockets-express": "2.0.4",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#b1092c70692ddbcc87464a77da44848614f6342a"
  },
  "devDependencies": {
    "@colyseus/testing": "0.18.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15"
  }
}
