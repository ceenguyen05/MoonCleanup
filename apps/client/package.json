{
  "name": "@moon-cleanup/client",
  "version": "0.0.0",
  "private": true,
  "description": "Clean The Moon! browser client: Vite + three.js WebGPURenderer + React HUD (static, deployed to Vercel).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "size:check": "node ../../.github/scripts/size-check.mjs dist"
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.10",
    "@moon-cleanup/game-data": "workspace:*",
    "@moon-cleanup/protocol": "workspace:*",
    "@moon-cleanup/shared": "workspace:*",
    "@moon-cleanup/sim": "workspace:*",
    "@moon-cleanup/world": "workspace:*",
    "@sentry/browser": "11.12.0",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "11.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
