# =============================================================================================
# apps/client/.env.example
#
# Copy to apps/client/.env.local for local development (that file is git-ignored).
# Real hosted/preview values are set ONLY in the Vercel dashboard:
#   Vercel -> Project "moon-cleanup" -> Settings -> Environment Variables
# and are exposed to the browser bundle, so NEVER put a secret in any VITE_* variable.
# Names must keep the VITE_ prefix or Vite will not expose them to client code.
# =============================================================================================

# Base HTTP URL of the game server REST API (guest auth, profile, contracts list, room joins).
# The client probes /healthz only after the first title-screen interaction (never on page load).
# The build also injects this origin (and the WS origin) into a meta Content-Security-Policy
# connect-src (docs/architecture/security.md section 4.4).
# Local: the dev server started by `pnpm dev` (port 2567 + agent offset N, see module-boundaries 6).
# Production: the HTTPS URL of the Render service "moon-cleanup-server"
#   (Render dashboard -> the service -> top of the page, "https://<name>.onrender.com").
# Production Branch is main; there is one Render service, no permanent staging service.
# Connection instructions: docs/HOSTING_GUIDE.md.
VITE_SERVER_HTTP_URL=http://localhost:2567

# WebSocket URL of the Colyseus server. Same host as above with ws:// (local) or wss:// (Render).
# Production example shape: wss://<service-name>.onrender.com  (take the host from the Render dashboard)
VITE_SERVER_WS_URL=ws://localhost:2567

# Sentry DSN of the BROWSER project (Sentry -> Settings -> Projects -> <client project>
# -> Client Keys (DSN)). A DSN is public by design (it ends up in the bundle). Leave empty to
# disable error reporting locally.
VITE_SENTRY_DSN=

# Build identifier shown in the perf HUD, sent as clientBuild and attached to Sentry events.
# On Vercel it is set by the build command in vercel.json from VERCEL_GIT_COMMIT_SHA (do not set it
# in the dashboard). Locally leave "dev".
VITE_BUILD_VERSION=dev

# Environment label: local | preview | production (staging is a reserved internal value).
# Set per environment in the Vercel dashboard (Production = production, Preview = preview).
VITE_ENV=local

# Dev flag (v1.0 feature): run RoomSim in a Web Worker without a server. Empty or false = off.
# Where: this file locally, or the Vercel dashboard.
VITE_OFFLINE_SOLO=

# ---- Build-time only (Vercel build, NOT VITE_*, never bundled) --------------------------------
# VERCEL_GIT_COMMIT_SHA is provided by Vercel automatically; do not set it.

# SECRET: uploads source maps to Sentry during the Vercel build. Leave empty locally.
# Where: Sentry -> Settings -> Auth Tokens -> create; paste into the Vercel dashboard only.
SENTRY_AUTH_TOKEN=

# Sentry organisation slug (Sentry -> Settings -> General). Vercel dashboard.
SENTRY_ORG=

# Sentry client project slug (Sentry -> Project Settings -> General). Vercel dashboard.
SENTRY_PROJECT=
